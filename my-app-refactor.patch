+}
+
+.icon {
+	font-size: 2rem;
+	line-height: 1;
+}
+
+.cardTitle {
+	margin-top: 0.5rem;
+	font-size: 1.125rem;
+	font-weight: 600;
+}
+
+.cardSubtitle {
+	font-size: 0.75rem;
+	color: var(--slate-500);
+}
+
+.cardDescription {
+	margin-top: 0.5rem;
+	font-size: 0.875rem;
+	line-height: 1.5;
+	color: var(--slate-600);
+}
