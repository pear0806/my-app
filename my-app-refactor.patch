+	padding: 2rem 1rem;
+	color: var(--slate-900);
+	background:
+		radial-gradient(1200px 500px at 10% -10%, #d7f3e3 0%, transparent 55%),
+		radial-gradient(900px 400px at 110% 0%, #dbeafe 0%, transparent 50%), #f3f6f4;
+}
+
+.title {
+	font-size: clamp(2rem, 1.5rem + 2vw, 3rem);
